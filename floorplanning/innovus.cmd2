set_global _enable_mmmc_by_default_flow      $CTE::mmmc_default
suppressMessage ENCEXT-2799
getVersion
set init_verilog ../syn/sweep/E4/top_netlist.v
set init_design_netlisttype Verilog
set init_design_settop 1
set init_top_cell top
set init_lef_file {../lef/tech_c1d.lef ../lef/core_c1d.lef ../lef/corner_c1d.lef ../lef/io_c1d.lef}
set init_mmmc_file mmmc.tcl
init_design
floorPlan -r 1.0 0.7 20 20 20 20
editPin -fixedPin -pin * -spreadDirection clockwise -side Top -layer metal2 -spacing 2
win
