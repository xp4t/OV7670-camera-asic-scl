             -rise_from <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+ |
             -fall_from <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+ ]
           [ -to <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+ |
             -rise_to <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+ |
             -fall_to <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+ ]
           [ -through <port|inst|hinst|pin|hpin|hnet|port_bus|hpin_bus>+ |
             -rise_through <port|inst|hinst|pin|hpin|hnet|port_bus|hpin_bus>+ |
             -fall_through <port|inst|hinst|pin|hpin|hnet|port_bus|hpin_bus>+ ]+
           [-comment <string>] [-exception_name <string>] [-combinational_from_to] [-ignore_clock_latency] [-reset_path] <float>

    [-rise]:
        rise value 
    [-fall]:
        fall value 
    -from <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+:
        a set of startpoints for the paths 
    -rise_from <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+:
        startpoints with a rise transition at the pin itself 
    -fall_from <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+:
        startpoints with a fall transition at the pin itself 
    -to <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+:
        a set of endpoints for the paths 
    -rise_to <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+:
        endpoints with a rise transition at the pin itself 
    -fall_to <clock|port|inst|hinst|pin|hpin|port_bus|hpin_bus>+:
        endpoints with a fall transition at the pin itself 
    -through <port|inst|hinst|pin|hpin|hnet|port_bus|hpin_bus>+:
        through list 
    -rise_through <port|inst|hinst|pin|hpin|hnet|port_bus|hpin_bus>+:
        this option specifies paths that contain a rise transition in one of these objects and it can be repeated and can be combined with -through and/or -through_fall_pin 
    -fall_through <port|inst|hinst|pin|hpin|hnet|port_bus|hpin_bus>+:
        this option specifies paths that contain a fall transition in one of these objects and it can be repeated and can be combined with -through and/or -through_rise_pin 
    [-comment <string>]:
        comment to be tagged with this command 
    [-exception_name <string>]:
        name of the timing exception 
    [-combinational_from_to]:
        defines path defined by -from/to pins as combinational 
    [-ignore_clock_latency]:
        ignore clock latency 
    [-reset_path]:
        reset any other exceptions on this path spec and apply this exception 
    <float>:
        delay value 

