    [-pre_route_clock_res <float>]:
        factor for pre-route resistances on clock tree 
    [-pre_route_clock_cap <float>]:
        factor for pre-route capacitances on clock tree 
    [-post_route_clock_res <float>+]:
        triplet factors for post-route resistances on clock tree 
    [-post_route_clock_cap <float>+]:
        triplet factors for post-route capacitances on clock tree 

