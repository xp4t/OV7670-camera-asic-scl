COMMAND: add_core_wrapper_cell
==================================================
  add_core_wrapper_cell: inserts an IEEE compliant 1500 style core wrapper cell 

Usage: add_core_wrapper_cell -locations <pin|hpin|port>+ [-override_threshold_use_shared <pin|hpin|port>+] [-override_threshold_use_dedicated <pin|hpin|port>+] [-exclude <pin|hpin|port>+]
           [-exclude_clock <test_clock>+] [-wck <pin|hpin|port>] [-wsen_in <pin|hpin|port>] [-wsen_out <pin|hpin|port>] [-wsen_reuse_or_for_shared_wrapper] [-wcap <pin|hpin|port>]
           [-wint <constant|pin|hpin|port>] [-wext <constant|pin|hpin|port>] [-wint_in_out <constant|pin|hpin|port>] [-input_select_cfi <pin|hpin|port>] [-output_select_cfi <pin|hpin|port>]
           [-guard <string>] [-input_guard_control <pin|hpin|port>] [-output_guard_control <pin|hpin|port>] [-inside_core] [-preview] [-input_shared_threshold <integer>]
           [-output_shared_threshold <integer>] [-input_shared_depth_threshold <integer>] [-output_shared_depth_threshold <integer>] [-exclude_combinational_feedthru_paths]
           [-dont_reuse_input_wrappers_for_output_ports] [-wrap_tied_constant_ports] [-shared_through {buffer|buffers|inverters_and_buffers|combinational}]
           [-skip_locations_variable <string>] [-floating_location_allowed] [-name <string>] [-no_mux_before_shared_cell] [-respect_dft_constants {test_setup_shiftenable|test_setup|tied}]
           [-map_to_mux_for_dedicated_wrapper] [-map_to_mux_for_shared_wrapper_cell] [-use_power_domain_of_ports_for_dedicated] [-dont_wrap_floating_locations_for_hierarchical_pins]
           [-add_xor_feedback <pin|hpin|port>] [-inside_sink_hierarchy] [-no_wrapper_in_hierarchy <string>] [-no_toggle_inverter_for_shared_wrapper] [-design <design>]

    -locations <pin|hpin|port>+:
        where to insert the wrapper cell 
    [-override_threshold_use_shared <pin|hpin|port>+]:
        list of ports to force shared wrapper cells 
    [-override_threshold_use_dedicated <pin|hpin|port>+]:
        list of ports to force dedicated wrapper cells 
    [-exclude <pin|hpin|port>+]:
        pin or ports to be excluded for wrapper cell insertion 
    [-exclude_clock <test_clock>+]:
        test clock to be excluded for dedicated wrapper cells 
    [-wck <pin|hpin|port>]:
        test clock source pin/port to be used for dedicated wrapper cells 
    [-wsen_in <pin|hpin|port>]:
        shift enable source pin/port for input bounding flops 
    [-wsen_out <pin|hpin|port>]:
        shift enable source pin/port for output bounding flops 
    [-wsen_reuse_or_for_shared_wrapper]:
        use a single top level or for shared wrapper cells 
    [-wcap <pin|hpin|port>]:
        capture control source pin/port 
    [-wint <constant|pin|hpin|port>]:
        inward-facing control source pin/port 
    [-wext <constant|pin|hpin|port>]:
        outward-facing control source pin/port 
    [-wint_in_out <constant|pin|hpin|port>]:
        both-facing control source pin/port 
    [-input_select_cfi <pin|hpin|port>]:
        source pin/port of decoded control logic for input select_cfi 
    [-output_select_cfi <pin|hpin|port>]:
        source pin/port of decoded control logic for output select_cfi 
    [-guard <string>]:
        guard (safe value) out of cell 
    [-input_guard_control <pin|hpin|port>]:
        guard control source pin/port for inward-facing wrapper cells 
    [-output_guard_control <pin|hpin|port>]:
        guard control source pin/port for outward-facing wrapper cells 
    [-inside_core]:
        insert the wrapper cells associated with hierarchical pins inside the core module 
    [-preview]:
        preview only 
    [-input_shared_threshold <integer>]:
        specifies the maximum number of scannable flops which can be shared in wrapper cells for an input port (default:10) 
    [-output_shared_threshold <integer>]:
        specifies maximum number of scannable flops which can be shared in wrapper cells for an output port (default:10) 
    [-input_shared_depth_threshold <integer>]:
        specifies the maximum combinational depth of scannable flops which can be share d in wrapper cells for an input port 
    [-output_shared_depth_threshold <integer>]:
        specifies the maximum combinational depth of scannable flops which can be shared in wrapper cells for an outport port 
    [-exclude_combinational_feedthru_paths]:
        specifies to exclude wrapper cells for those input and output ports with combinational logic between the ports 
    [-dont_reuse_input_wrappers_for_output_ports]:
        specifies to insert dedicated wrapper cells for output ports which are being fed by wrapper cells inserted for input ports 
    [-wrap_tied_constant_ports]:
        specifies to wrap output ports that are tied to logic constants 
    [-shared_through {buffer|buffers|inverters_and_buffers|combinational}]:
        share the functional flop in the fanin or fanout of the pin location using the following tracing method (buffers|inverters_and_buffers|combinational) 
    [-skip_locations_variable <string>]:
        variable name where the unwrappable locations are to be returned 
    [-floating_location_allowed]:
        insert wrapper cell even if location is floating 
    [-name <string>]:
        segment name 
    [-no_mux_before_shared_cell]:
        do not insert mux before shared wrapper cell 
    [-respect_dft_constants {test_setup_shiftenable|test_setup|tied}]:
        consider dft constants 'test_setup_shiftenable' or 'tied' or 'test_setup' (both tied, shift_enable and test-mode propagated values) 
    [-map_to_mux_for_dedicated_wrapper]:
        keep binary muxes intact inside the dedicated wrapper cell 
    [-map_to_mux_for_shared_wrapper_cell]:
        keep binary muxes intact inside the shared wrapper cell 
    [-use_power_domain_of_ports_for_dedicated]:
        use power domain of port for dedicated wrapper cell 
    [-dont_wrap_floating_locations_for_hierarchical_pins]:
        skip floating location that does not have any source or sink 
    [-add_xor_feedback <pin|hpin|port>]:
        add xor feedback on hold path and use pin/port as an input to xor gate 
    [-inside_sink_hierarchy]:
        insert dedicated wrapper cell inside the sink hierarchy 
    [-no_wrapper_in_hierarchy <string>]:
        no wrapper inside hierarchy 
    [-no_toggle_inverter_for_shared_wrapper]:
        do not add toggle inverter on the hold path of shared wrapper cell 
    [-design <design>]:
        the name of the top-block (required if there are multiple top designs) 

