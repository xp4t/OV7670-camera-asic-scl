COMMAND: apply_cglar
==================================================
  apply_cglar: do xor gating analysis for the design 

Usage: apply_cglar [-elab_db <string>] [-elab_tcl <string>] [-mapped_db <string>] [-mapped_tcl <string>] [-netlist <string>] [-top_design <string>] [-sdc <string>] [-def <string>]
           [-lib_proc <string>] [-read_stimulus_options <string>] [-compute_cglar_options <string>] [-report_cglar_options <string>] [-pre_script <string>] [-post_script <string>]
           [-do_not_implement_cglar] [-no_db] [-power_data] [-unit <string>] [-format <string>] [-verbose] [-work <string>]

    [-elab_db <string>]:
        elab database with Joules default naming rules for rtlstim2gate flow 
    [-elab_tcl <string>]:
        tcl applicable with -elab_db 
    [-mapped_db <string>]:
        genus database 
    [-mapped_tcl <string>]:
        tcl applicable with target database 
    [-netlist <string>]:
        3rd party netlist 
    [-top_design <string>]:
        top design name with netlist 
    [-sdc <string>]:
        sdc file with netlist 
    [-def <string>]:
        def file with netlist 
    [-lib_proc <string>]:
        tcl proc for library settings 
    [-read_stimulus_options <string>]:
        read_stimulus options (check help of read_stimulus in joules) 
    [-compute_cglar_options <string>]:
        compute cglar options (check help of compute_cglar in joules) 
    [-report_cglar_options <string>]:
        report cglar options (check help of report_cglar in joules) 
    [-pre_script <string>]:
        tcl file source before read_stim 
    [-post_script <string>]:
        tcl file source after implement cglar 
    [-do_not_implement_cglar]:
        do not implement back in genus session 
    [-no_db]:
        write netlist based flow 
    [-power_data]:
        enable power reporting before and after xor gating 
    [-unit <string>]:
        specify the power unit W|mW|uW|nW|pW (supported only with -power_data, default: W) 
    [-format <string>]:
        specify the power format (support only with -power_data) 
    [-verbose]:
        apply xor gating in verbose mode 
    [-work <string>]:
        joules working directory, default:genus2joules_work 

