#@ Processing -files option
@genus 1> source script.tcl
#@ Begin verbose source ./script.tcl
@file(script.tcl) 1: set fp [open "commands.txt" r]
@file(script.tcl) 3: while {[gets $fp cmd] >= 0} {

    set cmd [string trim $cmd]
    if {$cmd eq ""} {
        continue
    }

    puts "\n=================================================="
    puts "COMMAND: $cmd"
    puts "=================================================="

    catch {
        eval "$cmd -help"
    }
}

==================================================
COMMAND: report_summary
==================================================
  report_summary: generates a summary table including various QoS numbers for various stages in the flow. This command has to be preceded with the 'write_reports' command, which creates the 
                  QoS statistics to be used by this command. 

Usage: report_summary [-directory <string>]

    [-directory <string>]:
        specifies the path to the directory where the output data of this command is to be stored 

==================================================
COMMAND: add_analyzed_test_points
==================================================
  add_analyzed_test_points: inserts test points analyzed by Modus 

Usage: add_analyzed_test_points -input_test_point_file <string> [-max_number_of_test_point_nodes <integer>] [-min_slack <integer>] [-fault_threshold <integer>] [-test_control <test_signal>]
           [-test_clock_pin <pin|hpin|port>] [-share_observe_flop <integer>] [-observe_only] [-control_only] [-gate_clock_test_control <test_signal>] [-gate_clock_for_observe <test_signal>]
           [-dont_map] [-max_number_of_test_point_flops <integer>] [-preview] [-verbose] [<design>]

    -input_test_point_file <string>:
        input test-point file name 
    [-max_number_of_test_point_nodes <integer>]:
        maximum number of test points to be inserted <default: all> 
    [-min_slack <integer>]:
        minimum slack (in ps) for inserting a test point 
    [-fault_threshold <integer>]:
        testpoints locations whose fault count is greater than or equal to threshold are inserted <default:0> 
    [-test_control <test_signal>]:
        test signal used to control the testpoint(s) 
    [-test_clock_pin <pin|hpin|port>]:
        test clock to control testpoint 
    [-share_observe_flop <integer>]:
        number of observation testpoints that may share a flop 
    [-observe_only]:
        insert observation type test points only 
    [-control_only]:
        insert control type test points only 
    [-gate_clock_test_control <test_signal>]:
        test signal used to gate the clock for control flop 
    [-gate_clock_for_observe <test_signal>]:
        test signal used to gate the clock for observation flop 
    [-dont_map]:
        skip mapping testpoints even if design is mapped 
    [-max_number_of_test_point_flops <integer>]:
        maximum number of test point flops to be inserted 
    [-preview]:
        preview run command in preview mode 
    [-verbose]:
        print details of testpoints 
    [<design>]:
        top-level design to perform testpoint selection on 

==================================================
COMMAND: add_assign_buffer_options
==================================================
  add_assign_buffer_options: controls replacement of assign statements during synthesis 

Usage: add_assign_buffer_options [-ignore_preserve_map_size_ok] [-allow_unloaded_buffers] [-ignore_preserve_setting] [-dont_respect_boundary_optimization] [-no_buffers_use_inverters]
           [-preserve_dangling_nets] [-dont_skip_unconstrained_paths] [-skip_ideal_nets] [-skip_hierarchical_subdesigns] [-include_local_constant_assign] [-buffer_or_inverter <lib_cell>]
           [-clock_buffer_or_inverter <lib_cell>] [-use_inverted_signal] [-ports <string>] [-verbose] [-reset] [-design <design|module>]

    [-ignore_preserve_map_size_ok]:
        ignores the preserve map_size_ok setting on module 
    [-allow_unloaded_buffers]:
        allow unloaded buffers to be created 
    [-ignore_preserve_setting]:
        ignores all preserve setting 
    [-dont_respect_boundary_optimization]:
        does not respect boundary optimizations 
    [-no_buffers_use_inverters]:
        look for inverters to be used in case the library does not have any buffers 
    [-preserve_dangling_nets]:
        preserve the net driven by the buffer/inverter inserted by remove_assigns 
    [-dont_skip_unconstrained_paths]:
        remove assigns on unconstrained paths 
    [-skip_ideal_nets]:
        do not remove assigns on ideal nets 
    [-skip_hierarchical_subdesigns]:
        do not remove assigns from any hierarchies inside provided design/subdesign 
    [-include_local_constant_assign]:
        remove local constant driven assigns also which do not drive hierarchical ports 
    [-buffer_or_inverter <lib_cell>]:
        libcell to be used for 
    [-clock_buffer_or_inverter <lib_cell>]:
        clock libcell to be used for 
    [-use_inverted_signal]:
        use single inverter with inverted signal instead of buffer if inverter is smaller than buffer 
    [-ports <string>]:
        remove assigns only on these ports 
    [-verbose]:
        displays all the messages 
    [-reset]:
        reset all the options to default values 
    [-design <design|module>]:
        top level designs or subdesigns to recur from 

