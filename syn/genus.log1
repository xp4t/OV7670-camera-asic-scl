Usage: write_scandef [-version <string>] [-partition <string>]+ [-chains <actual_scan_chain>+]+ [-dont_use_timing_model_pins] [-end_chains_before_lockups]
           [-end_chains_before_mm_fanout_flops] [-dont_split_by_library_domains] [-dont_split_by_power_domains] [-split_by_combo_segments] [-start_stop_at_anchor_buffers]
           [-dft_cfg_mode <dft_configuration_mode>] [-dft_configuration_mode <dft_configuration_mode>] [<design>] [> file]

    [-version <string>]:
        scandef version to write '5.4' or '5.5' (default: 5.5) 
    [-partition <string>]:
        specifies the user defined partition name 
    [-chains <actual_scan_chain>+]:
        specifies the chains that are to be part of the user defined partition 
    [-dont_use_timing_model_pins]:
        if true then trace outwards to first/last flop's SDO/SDI respectively and use that as start/stop pin 
    [-end_chains_before_lockups]:
        if true then use the SI pin of the FF preceding the lockup as termination point for chain 
    [-end_chains_before_mm_fanout_flops]:
        if true then use the SI pin of the FF that fans out to multiple chains as the termination point for chain 
    [-dont_split_by_library_domains]:
        if true then dont split the chain at the SI pin of the last flop in the from library domain and at the Q/SO pin of the first flop in the to library domain 
    [-dont_split_by_power_domains]:
        if true then dont split the chain at the SI pin of the last flop in the from power domain and at the Q/SO pin of the first flop in the to power domain 
    [-split_by_combo_segments]:
        if true then split chain at SI pin of flop preceding segment with starting combinational logic and at Q pin of flop following segment with ending combinational logic 
    [-start_stop_at_anchor_buffers]:
        if true then start and stop chain at anchor buffers 
    [-dft_cfg_mode <dft_configuration_mode>]:
        write scandef for specified configuration mode 
    [-dft_configuration_mode <dft_configuration_mode>]:
        write scandef for specified configuration mode 
    [<design>]:
        writes scan chain information in def to reordering 

