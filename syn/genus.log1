           [-bsr_updatedr <pin|hpin|port|subport>] [-reset <pin|hpin|port|subport>] [-runidle <pin|hpin|port|subport>] [-shiftdr <pin|hpin|port|subport>] [-clockdr <pin|hpin|port|subport>]
           [-updatedr <pin|hpin|port|subport>] [-updatedr_state <pin|hpin|port|subport>] [-capturedr_state <pin|hpin|port|subport>] [-shiftdr_state <pin|hpin|port|subport>]
           [-capturedr <pin|hpin|port|subport>] [-exit1dr_state <pin|hpin|port|subport>] [-mode_a <pin|hpin|port|subport>] [-mode_b <pin|hpin|port|subport>] [-mode_c <pin|hpin|port|subport>]
           -tdi <pin|hpin|port|subport> [-boundary_tdo <pin|hpin|port|subport>] -tdo <pin|hpin|port|subport> [-highz <pin|hpin|port|subport>] [-tdo_enable <pin|hpin|port|subport>]
           -tck <pin|hpin|port|subport> -tms <pin|hpin|port|subport> [-trst <pin|hpin|port|subport>] [-dot6_ac_dc_select <pin|hpin|port|subport>] [-dot6_preset_clock <pin|hpin|port|subport>]
           [-dot6_trcell_enable <pin|hpin|port|subport>] [-dot6_ac_pulse <pin|hpin|port|subport>] [-power_on_reset <pin|hpin|port|subport>] [-name <string>]

    [-module <module>]:
        the module name of the JTAG_Macro instance 
    [-lib_cell <base_cell>]:
        the libcell name of the JTAG_Macro instance 
    [-instance <inst|hinst>]:
        the path name of the JTAG_Macro instance 
    [-bsr_shiftdr <pin|hpin|port|subport>]:
        the shift data register (SHIFTDR) output pin for the boundary-scan register 
    [-bsr_clockdr <pin|hpin|port|subport>]:
        the clock data register (CLOCKDR) output pin for the boundary-scan register 
    [-bsr_updatedr <pin|hpin|port|subport>]:
        the update data register (UPDATEDR) output pin for the boundary-scan register 
    [-reset <pin|hpin|port|subport>]:
        the reset output pin indicating JTAG_Macro is in the Test-Logic-Reset state 
    [-runidle <pin|hpin|port|subport>]:
        the runidle output pin indicating JTAG_Macro is in the Run-Test-Idle state 
    [-shiftdr <pin|hpin|port|subport>]:
        the shift data register (SHIFTDR) output pin for the custom test data register 
    [-clockdr <pin|hpin|port|subport>]:
        the clock data register (CLOCKDR) output pin for the custom test data register 
    [-updatedr <pin|hpin|port|subport>]:
        the update data register (UPDATEDR) output pin for the custom test data register 
    [-updatedr_state <pin|hpin|port|subport>]:
        the update data register (UPDATEDR_STATE) output pin for the custom test data register 
    [-capturedr_state <pin|hpin|port|subport>]:
        the capture data register (CAPTUREDR_STATE) output pin for the custom test data register 
    [-shiftdr_state <pin|hpin|port|subport>]:
        the shift data register (SHIFTDR_STATE) output pin for the custom test data register 
    [-capturedr <pin|hpin|port|subport>]:
        the capture data register (CAPTUREDR) output pin for the custom test data register 
    [-exit1dr_state <pin|hpin|port|subport>]:
        the exit1dr data register (EXIT1DR) state output pin on the JTAG_Macro for use with LBIST logic 
    [-mode_a <pin|hpin|port|subport>]:
        the mode_a output pin to configure boundary-cells in boundary-scan register 
    [-mode_b <pin|hpin|port|subport>]:
        the mode_b output pin to configure boundary-cells in the boundary-scan register 
    [-mode_c <pin|hpin|port|subport>]:
        the mode_c output pin to configure boundary-cells in the boundary-scan register 
    -tdi <pin|hpin|port|subport>:
        TAP controller TDI input pin on the JTAG_Macro 
    [-boundary_tdo <pin|hpin|port|subport>]:
        the boundary-register TDO input pin on the JTAG_Macro 
    -tdo <pin|hpin|port|subport>:
        TAP controller TDO output pin on the JTAG_Macro 
    [-highz <pin|hpin|port|subport>]:
        the highz output pin to place the I/Os pads in their HIGHZ state 
    [-tdo_enable <pin|hpin|port|subport>]:
        the enable output pin which drives the JTAG TDO output enable pin 
    -tck <pin|hpin|port|subport>:
        TAP controller TCK input pin on the JTAG_Macro 
    -tms <pin|hpin|port|subport>:
        TAP controller TMS input pin on the JTAG_Macro 
    [-trst <pin|hpin|port|subport>]:
        TAP controller TRST input pin on the JTAG_Macro 
    [-dot6_ac_dc_select <pin|hpin|port|subport>]:
        the logical OR of the decoded EXTEST_PULSE and EXTEST_TRAIN instructions 
    [-dot6_preset_clock <pin|hpin|port|subport>]:
        the positive-active edge-sensitive clock signal to test receivers that have edge-sensitive initialization 
    [-dot6_trcell_enable <pin|hpin|port|subport>]:
        the logical OR of EXTEST, EXTEST_PULSE and EXTEST_TRAIN used to enable the test receiver cells 
    [-dot6_ac_pulse <pin|hpin|port|subport>]:
        the AC test signal output of the Jtag_Macro 
    [-power_on_reset <pin|hpin|port|subport>]:
        the power-on reset input pin on the JTAG_Macro 
    [-name <string>]:
        name of the JTAG_Macro 

==================================================
COMMAND: define_jtag_tap_port
==================================================
  define_jtag_tap_port: defines a test access port (TAP) 

Usage: define_jtag_tap_port -type <string> [-tck_period <integer>] [-hookup_pin <pin|hpin|port>] [-hookup_polarity <string>] [-create_port] [-no_trst_test_signal] <string> [<design>]

    -type <string>:
        type of tap port 'tdi' 'tdo' 'tck' 'tms' 'trst' or 'tdo_enable' 
    [-tck_period <integer>]:
        tap tck period 
    [-hookup_pin <pin|hpin|port>]:
        consider this as the core side hookup pin 
    [-hookup_polarity <string>]:
        polarity of signal (inverted | non_inverted) 
    [-create_port]:
        create port if it does not exist 
    [-no_trst_test_signal]:
        no test signal is defined on the trst port 
    <string>:
        port or pin 
    [<design>]:
        define tap port for this top design 

==================================================
COMMAND: define_mbist_clock
==================================================
  define_mbist_clock: defines an MBIST clock 

Usage: define_mbist_clock [-name <string>] -period <integer> [-design <design>] [-hookup_pin <pin|hpin>] [-hookup_period <integer>] [-hookup_polarity <string>] [-internal_clock_source]
           [-pulsed_clock_source] [-is_jtag_tck] [-is_srclk] [-domain <string>] <port>

    [-name <string>]:
        clock name 
    -period <integer>:
        period interval in picoseconds at port 
    [-design <design>]:
        top-block (required if there are multiple top designs) 
    [-hookup_pin <pin|hpin>]:
        consider this as the core side hookup pin 
    [-hookup_period <integer>]:
        period interval in picoseconds at hookup pin (default is identical to period value) 
    [-hookup_polarity <string>]:
        polarity of signal (inverted | non_inverted) 
    [-internal_clock_source]:
        whether the clock is an internal clock 
    [-pulsed_clock_source]:
        whether the clock is a pulsed clock 
    [-is_jtag_tck]:
        whether the clock is a JTAG TCK 
    [-is_srclk]:
        alternate clock for use in repair interface to memories 
    [-domain <string>]:
        domain name (default is assigning each clock to a different domain) 
    <port>:
        source port 

==================================================
COMMAND: define_metric
==================================================
  define_metric: define a new metric to be calculated 

Usage: define_metric -name <string> [-tcl <string>] [-type <string>] [-description <string>] [-units <string>] [-precision <integer>] [-compare <string>] [-threshold <string>]
           [-no_inheritance] [-inherit_no_children] [-inheritance_tcl <string>] [-target <string>] [-warning <string>] [-tools <string>] [-id <string>]

    -name <string>:
        metric name 
    [-tcl <string>]:
        tcl code to generate the metric value 
    [-type <string>]:
        metric type 
    [-description <string>]:
        metric description 
    [-units <string>]:
        metric units 
    [-precision <integer>]:
        metric display precision (default 0) 
    [-compare <string>]:
        compare function 
    [-threshold <string>]:
        threshold for any comparison 
    [-no_inheritance]:
        disable inheritance of the metric 
    [-inherit_no_children]:
        run inheritance tcl even when there are no child values 
    [-inheritance_tcl <string>]:
        tcl for combining children values. Not executed in the global namespace. Equivalent proc args are {children previous children_uuid self_uuid previous_uuid metric db_id} 
    [-target <string>]:
        target or name of metric containing the target value 
    [-warning <string>]:
        warning threshold or name of metric containing the threshold value 
    [-tools <string>]:
        list of tools which the tcl code will run in 
    [-id <string>]:
        database ID 

==================================================
COMMAND: define_msg
==================================================
  define_msg: generates new messages in message archive 

Usage: define_msg -group <string> -id <integer> -short_description <string> [-internal_group] -long_description <string> [-error] [-warning] [-info_priority <integer>]

    -group <string>:
        group name 
    -id <integer>:
        id number (default 1) 
    -short_description <string>:
        short description of message 
    [-internal_group]:
        does the message belong to an internal group 
    -long_description <string>:
        long description of message 
    [-error]:
        the severity to 'error' 
    [-warning]:
        the severity to 'warning' 
    [-info_priority <integer>]:
        the severity to 'info' (2-8) 

==================================================
COMMAND: define_opcg_domain
==================================================
  define_opcg_domain: defines an OPCG domain 

Usage: define_opcg_domain [-name <string>] -osc_source <osc_source> [-domain_macro_parameter <domain_macro_parameter>] -opcg_trigger <opcg_trigger> [-location <pin|hpin|port|hport>]
           -min_domain_period <delay in picoseconds> [-divide_by <integer>] [-max_num_pulses <integer>] [-counter_length <integer>] [-scan_clock <test_clock>] [-shift_enable <test_signal>]
           [-instance <inst|hinst>] [-design <design>]

    [-name <string>]:
        name of domain macro parameter 
    -osc_source <osc_source>:
        osc source for the opcg domain 
    [-domain_macro_parameter <domain_macro_parameter>]:
        domain macro parameter for the opcg domain 
    -opcg_trigger <opcg_trigger>:
        opcg trigger for the opcg domain 
    [-location <pin|hpin|port|hport>]:
        location where the opcg domain is to be inserted 
    -min_domain_period <delay in picoseconds>:
        minimum time period at which the domain can operate 
    [-divide_by <integer>]:
        value by which to divide the Osc Source frequency 
    [-max_num_pulses <integer>]:
        number of pulses to be generated by the macro (default: 2, maximum: 8) 
    [-counter_length <integer>]:
        number of bits in the down counter register (default: 0 (no counter), or values between 4 and 7) 
    [-scan_clock <test_clock>]:
        scan clock for the opcg domain 
    [-shift_enable <test_signal>]:
        shift enable for the opcg domain 
    [-instance <inst|hinst>]:
        the OPCG domain instance 
    [-design <design>]:
        top-block (required if there are multiple top designs) 

==================================================
COMMAND: define_opcg_domain_macro_parameters
==================================================
  define_opcg_domain_macro_parameters: defines the parameters of an OPCG domain macro 

Usage: define_opcg_domain_macro_parameters [-name <string>] [-max_num_pulse <integer>] [-counter_length <integer>] [-max_trigger_delay <delay in picoseconds>]
           [-min_target_period <delay in picoseconds>] [-design <design>]

    [-name <string>]:
        name of domain macro parameter 
    [-max_num_pulse <integer>]:
        number of pulses to be generated by the macro (default: 2, maximum: 8) 
    [-counter_length <integer>]:
        number of bits in the down counter register (default: 0 (no counter), or values between 4 and 7) 
    [-max_trigger_delay <delay in picoseconds>]:
        time after which first pulse must be issued by domain macro on receipt of run signal from trigger macro 
    [-min_target_period <delay in picoseconds>]:
        time period (in picoseconds) at which the domain macro must operate (default: 1000) 
    [-design <design>]:
        top-block (required if there are multiple top designs) 

