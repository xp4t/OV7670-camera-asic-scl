==================================================
COMMAND: report_clock_gating
==================================================
  report_clock_gating: prints a clock-gating report 

Usage: report_clock_gating [-gated_ff] [-ungated_ff] [-detail] [-multi_stage_tree_view] [-include_one_flop] [-include_all_flops] [-multi_stage_count_from_flop] [-multi_stage_count_from_root]
           [-no_hierarchical] [-cg_instance <inst|hinst>+] [-clock <string>] [-clock_pin <pin|hpin|port|hport>+] [-instance <inst|hinst>] [-fanout_histogram] [-step <string>] [<design>]
           [> file]

    [-gated_ff]:
        report gated flip-flops 
    [-ungated_ff]:
        report ungated flip-flops 
    [-detail]:
        report detailed clock gating information 
    [-multi_stage_tree_view]:
        report multi-stage CG hierarchy in tree view 
    [-include_one_flop]:
        when reporting multi-stage CG hierarchy in tree view include one flop per CG 
    [-include_all_flops]:
        when reporting multi-stage CG hierarchy in tree view include all flops 
    [-multi_stage_count_from_flop]:
        report multi-stage CG hierarchy, where the CG nearest to a flop is 
    [-multi_stage_count_from_root]:
        report multi-stage CG hierarchy 
    [-no_hierarchical]:
        report current design/subdesign only 
    [-cg_instance <inst|hinst>+]:
        report detail clock gating information given the list of clock gating hierarchical instances 
    [-clock <string>]:
        report stages of clock-gating for clocks 
    [-clock_pin <pin|hpin|port|hport>+]:
        report stages of clock-gating for pin clock_pin 
    [-instance <inst|hinst>]:
        report clock gating information given the name of a hierarchical instance 
    [-fanout_histogram]:
        prints for a set of fanout ranges, the number of clock-gating instances with a fanout in that range, and the total number of flip-flops and bits that these clock-gating instances 
        directly gate 
    [-step <string>]:
        takes list of lists for user given step range rather than default step ranges, for example {{1 1} {5 7}} will have the following ranges 1->1, 5->7 and uncovered ranges 3->6, 
        8->higher 
    [<design>]:
        design to report on 

