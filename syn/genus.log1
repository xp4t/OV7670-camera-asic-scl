    [-end_point_limit <integer>]:
        dont report endpoints count below this limit 
    [-system_clock_violations]:
        report only system clock violations 
    [-report_internal]:
        report count of endpoints that receive data only from the same domain 
    [-verbose]:
        list all endpoints 
    [<design>]:
        reports DFT clock domain information 

