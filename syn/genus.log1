==================================================
COMMAND: write_dft_atpg
==================================================
  write_dft_atpg: writes out data and script files for Cadence ATPG 

Usage: write_dft_atpg [-library <string>] [-ncsim_library <string>] [-compression] [-delay] [-directory <string>] [-run_from_directory] [-continue_with_severe] [-force]
           [-build_model_options <string>] [-build_testmode_options <string>] [-build_faultmodel_options <string>] [-atpg_options <string>] [-verify_test_structures_options <string>]
           [-hier_test_core] [-hier_test_top] [-serial] [-unix_shell] [-core_verilog <string>] [-atpg_testmodes <string>] [-verbose] [<design>]

    [-library <string>]:
        list of Verilog Structural files for the library, e.g. "file1 file2" 
    [-ncsim_library <string>]:
        list of files for NCSIM, e.g. "file1 file2" 
    [-compression]:
        generates additional files for Modus to verify the compression logic 
    [-delay]:
        generates additional files for Modus to run delay test 
    [-directory <string>]:
        work directory name (default: current_working_directory/test_scripts). If the script files exist then rerunning the command may overwrite them 
    [-run_from_directory]:
        run atpg from Modus workdir 
    [-continue_with_severe]:
        continue Modus script execution even if severe warnings are encountered 
    [-force]:
        continue even when the DFT logic appears to be incomplete 
    [-build_model_options <string>]:
        extra options for building model (example "-option1 <string> -option2 <string>") 
    [-build_testmode_options <string>]:
        extra options for building testmode (example "-option1 <string> -option2 <string>") 
    [-build_faultmodel_options <string>]:
        extra options for building fault model (example "-option1 <string> -option2 <string>") 
    [-atpg_options <string>]:
        extra options for ATPG (example "-option1 <string> -option2 <string>") 
    [-verify_test_structures_options <string>]:
        extra options for verifying test structures (example "-option1 <string> -option2 <string>") 
    [-hier_test_core]:
        output Modus files for hierarchical test core flow 
    [-hier_test_top]:
        output Modus files for hierarchical test top flow 
    [-serial]:
        generates additional files for Modus to verify Serial testmodes 
    [-unix_shell]:
        write output in shell format 
    [-core_verilog <string>]:
        core level verilog path for atpg testmodes flow 
    [-atpg_testmodes <string>]:
        use atpg testmodes flow 
    [-verbose]:
        verbose message 
    [<design>]:
        top-level design for which to write out the Modus files 

==================================================
COMMAND: write_dft_atpg_other_vendor_files
==================================================
  write_dft_atpg_other_vendor_files: writes out scan chain information for other vendors ATPG engine 

Usage: write_dft_atpg_other_vendor_files [-stil] [-mentor] [-test_clock_waveform <test_clock>] [-apply_inputs_at <integer>] [-strobe_outputs_at <integer>] [-strobe_width <integer>]
           [-apply_bidirs_at <integer>] [-picoseconds] [-decimals_ok] [<design>] [> file]

    [-stil]:
        generates ATPG interface file in STIL format 
    [-mentor]:
        generates ATPG interface file for Mentor ATPG 
    [-test_clock_waveform <test_clock>]:
        uses clock waveform of the specified clock 
    [-apply_inputs_at <integer>]:
        the percentage of clock period at which inputs are applied 
    [-strobe_outputs_at <integer>]:
        the percentage of clock period at which outputs are strobed 
    [-strobe_width <integer>]:
        the percentage of clock period for which the outputs are valid 
    [-apply_bidirs_at <integer>]:
        the percentage of clock period at which bidirectionals are applied 
    [-picoseconds]:
        uses picoseconds as the unit of time 
    [-decimals_ok]:
        writes out decimals 
    [<design>]:
        writes ATPG for this top module 

==================================================
COMMAND: write_dft_bsdl
==================================================
  write_dft_bsdl: writes out BSDL information for a design 

Usage: write_dft_bsdl -directory <string> [-include_private_instructions] [-expose_ports_with_pin_map] [-pin_map_file <string>] [-file <string>] [-bsdl_package_name <string>]
           [-design <object>]

    -directory <string>:
        work directory name (if the script files exist then rerunning the command may overwrite them) 
    [-include_private_instructions]:
        include register access information for private instructions 
    [-expose_ports_with_pin_map]:
        only expose ports with physical pinmap information in the BSDL file 
    [-pin_map_file <string>]:
        file name of the pinmap file used to create BSDL for same die but with fewer pin-to-pad bonding requirements 
    [-file <string>]:
        file name of the output BSDL file to be generated 
    [-bsdl_package_name <string>]:
        name of the VHDL package which lists the custom boundary cells 
    [-design <object>]:
        top-level design to write bsdl 

==================================================
COMMAND: write_dft_compression_macro
==================================================
  write_dft_compression_macro: writes the RTL for the scan compression macro 

Usage: write_dft_compression_macro [-chains <integer>] [-scan_in <integer>] [-scan_out <integer>] [-asymmetric_scan_in <integer>] [-shared_scan_in_pins <string>] [-sub_chains <integer>]
           [-compressed_chains <integer>] [-separate_mask_ports] [-decompressor <string>] [-compressor <string>] [-mask <string>] [-allow_removal_of_cancelling_terms_for_hierarchical_flow]
           [-bitwise_compressor] [-mask_sharing_ratio <integer>] [-jtag_control] [-serial_misr_read] [-no_full_scan_muxing] [-block_select] [-file <string>] [-info_file <string>]
           [-low_pin_compression] [-smartscan_ratio <integer>] [-smartscan_serial_only] [-smartscan_no_update_stage] [-smartscan_pulse_width_multiplier <integer>]
           [-scan_in_pipeline_depth <integer>] [-scan_out_pipeline_depth <integer>] [-compressor_pipeline_depth <integer>]

    [-chains <integer>]:
        number of top level scan io 
    [-scan_in <integer>]:
        number of scan in pins for a general asymmetric macro 
    [-scan_out <integer>]:
        number of scan out pins for a general asymmetric macro 
    [-asymmetric_scan_in <integer>]:
        number of scan in pins for the asymmetric macro 
    [-shared_scan_in_pins <string>]:
        pins to share with scan in pins 
    [-sub_chains <integer>]:
        number of compression sub_chains 
    [-compressed_chains <integer>]:
        number of compressed chains 
    [-separate_mask_ports]:
        add mask ports to the compression macro 
    [-decompressor <string>]:
        decompression type 'broadcast' or 'xor' (default is 'broadcast') 
    [-compressor <string>]:
        compression type 'xor', 'misr' , 'smartscan_xor' or 'hybrid' (default is 'xor') 
    [-mask <string>]:
        masking type 'wide0', 'wide1', or 'wide2' (default is no masking support) 
    [-allow_removal_of_cancelling_terms_for_hierarchical_flow]:
        generates macro that eliminates cancellation at top level 
    [-bitwise_compressor]:
        compressor with bitwise xoring of channels 
    [-mask_sharing_ratio <integer>]:
        number of sub_chains sharing a mask register 
    [-jtag_control]:
        include a JTAG TDR to configure the compression testmode 
    [-serial_misr_read]:
        include support for reading the MISR bits serially through the scan data pins 
    [-no_full_scan_muxing]:
        do not include sub-chain MUXing logic internal to compression macro 
    [-block_select]:
        inserts block select logic to the compression macro 
    [-file <string>]:
        name of the compression macro file 
    [-info_file <string>]:
        name of the compression macro information file 
    [-low_pin_compression]:
        low pin count compression 
    [-smartscan_ratio <integer>]:
        length of the deserializer and serializer registers 
    [-smartscan_serial_only]:
        only serial smartscan interface 
    [-smartscan_no_update_stage]:
        update registers not to be added 
    [-smartscan_pulse_width_multiplier <integer>]:
        multiplier to widen the clock pulse 
    [-scan_in_pipeline_depth <integer>]:
        length of the input pipeline 
    [-scan_out_pipeline_depth <integer>]:
        length of the output pipeline 
    [-compressor_pipeline_depth <integer>]:
        length of the compressor pipeline 

==================================================
COMMAND: write_dft_compression_test_points
==================================================
  write_dft_compression_test_points: writes out data and script files for Compression testpoint Analysis 

Usage: write_dft_compression_test_points [-library <string>] [-directory <string>] [-run_from_directory] [-continue_with_severe] [-force] [-build_model_options <string>]
           [-build_faultmodel_options <string>] [-build_testmode_options <string>] [-compression_testpoints_options <string>] [-verify_test_structures_options <string>]
           [-min_slack_for_no_tp_file <integer>] [-intest] [<design>]

    [-library <string>]:
        list of Verilog Structural files for the library, e.g. "file1 file2" 
    [-directory <string>]:
        work directory name (default: current_working_directory/test_scripts). If the script files exist then rerunning the command may overwrite them 
    [-run_from_directory]:
        run atpg from Modus workdir 
    [-continue_with_severe]:
        continue test script execution even if severe warnings are encountered 
    [-force]:
        continue even when the DFT logic appears to be incomplete 
    [-build_model_options <string>]:
        extra options for building model (example "-option1 <string> -option2 <string>") 
    [-build_faultmodel_options <string>]:
        extra options for building fault model (example "-option1 <string> -option2 <string>") 
    [-build_testmode_options <string>]:
        extra options for building testmode (example "-option1 <string> -option2 <string>") 
    [-compression_testpoints_options <string>]:
        extra options for Compression Testpoints Analysis (example "-option1 <string> -option2 <string>") 
    [-verify_test_structures_options <string>]:
        extra options for verifying test structures (example "-option1 <string> -option2 <string>") 
    [-min_slack_for_no_tp_file <integer>]:
        slack (in ps) for preventing insertion of a test point <-10000000> 
    [-intest]:
        test point analysis in fullscan intest testmode 
    [<design>]:
        top-level design for which to write out the Modus files 

