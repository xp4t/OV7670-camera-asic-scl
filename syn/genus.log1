==================================================
COMMAND: report_power_intent
==================================================
  report_power_intent: prints Power Intent report 

Usage: report_power_intent [-design <design>] [-power_domain_only] [-isolation_rule_only] [-level_shifter_rule_only] [-state_retention_only] [-power_states] [-supply <string>]
           [-domain <power_domain>] [-detail] [-show_full_names] [-summary] [> file]

    [-design <design>]:
        top design for which report is required 
    [-power_domain_only]:
        report only power-domains 
    [-isolation_rule_only]:
        report only isolation rules with the domain it is defined for 
    [-level_shifter_rule_only]:
        report only level shifter rules with the domain it is defined for 
    [-state_retention_only]:
        report only state retention cells with the domain it is defined for 
    [-power_states]:
        report the Power State Table 
    [-supply <string>]:
        print the PST for given supply 
    [-domain <power_domain>]:
        reports ISO, LS and SRPG rules for this domain 
    [-detail]:
        gives detailed report 
    [-show_full_names]:
        print full names in report 
    [-summary]:
        only numbers of power intent given in one line each 

==================================================
COMMAND: report_power_intent_instances
==================================================
  report_power_intent_instances: prints Low Power cells report 

Usage: report_power_intent_instances [-design <design>] [-instance <inst|hinst>] [-lp_instance <inst|hinst>] [-summary] [-detail]
           [-rule <isolation_rule|level_shifter_rule|state_retention_rule>] [-isolation_only] [-level_shifter_only] [-state_retention_only] [-show_full_names] [-combo_only] [> file]

    [-design <design>]:
        top design for which report is required 
    [-instance <inst|hinst>]:
        hierarchy for which report is required 
    [-lp_instance <inst|hinst>]:
        report detail information for the given Low Power cell 
    [-summary]:
        only numbers of LP cells given in one line each 
    [-detail]:
        details report including pins(ISO/LS/Combo)/seq-instance(SRPG) on which low power cells has been inserted 
    [-rule <isolation_rule|level_shifter_rule|state_retention_rule>]:
        reports low_power_instances inserted by the specified rule 
    [-isolation_only]:
        report only isolation cells 
    [-level_shifter_only]:
        report only level shifter cells 
    [-state_retention_only]:
        report only state retention cells 
    [-show_full_names]:
        prints full names in report 
    [-combo_only]:
        report only COMBO(ISO+LS) cells 

