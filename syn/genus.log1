==================================================
COMMAND: add_pmbist
==================================================
  add_pmbist: inserts Programmable BIST (PMBIST) for memories 

Usage: add_pmbist [-directory <string>] [-allow_unused_instructions] [-config_file <string>] [-schedule_instruction <string>] [-check_instruction <string>] [-test_plan_instruction <string>]
           [-constraint_instruction <string>] [-rom_instruction <string>] [-rom_diagnostics_instruction <string>] [-diagnostics_instruction <string>] [-redundancy_instruction <string>]
           [-rom_path <string>] [-rom_data_map_file <string>] [-dont_scan] [-dont_scan_repair_registers] [-rom_data_files <string>] [-direct_access_only] [-connect_to_jtag]
           [-dont_create_pmbist_ports] [-preview] [-technology <integer>] [-technology_class <string>] [-module_prefix <string>] [-dft_cfg_mode <dft_configuration_mode>]
           [-alt_dft_cfg_mode <dft_configuration_mode>] [-amu_location <design|module|hinst>] [<design>]

    [-directory <string>]:
        work directory (default: './pmbist_<design name>') 
    [-allow_unused_instructions]:
        allow unused instruction decodes beyond those required for this design 
    [-config_file <string>]:
        name of the design specific configuration file 
    [-schedule_instruction <string>]:
        name of the jtag instruction to schedule engines and devices (default: 'MBISTSCH') 
    [-check_instruction <string>]:
        name of the jtag instruction to check results (default: 'MBISTCHK') 
    [-test_plan_instruction <string>]:
        name of the jtag instruction for testplan selection (default: 'MBISTTPN') 
    [-constraint_instruction <string>]:
        name of the jtag instruction for algorithm memory and test constraints (default: 'MBISTAMR'), required only with programmable testplans 
    [-rom_instruction <string>]:
        name of the jtag instruction for ROM testing (default: 'MBISTROM'), required only with ROMs 
    [-rom_diagnostics_instruction <string>]:
        name of the jtag instruction for ROM diagnostics (default: 'MBISTROMDIAG'), required only with ROMs 
    [-diagnostics_instruction <string>]:
        name of the jtag instruction for diagnostics (default: 'MBISTDIAG') 
    [-redundancy_instruction <string>]:
        name of the jtag instruction for redundancy analysis (default: 'MBISTRAR') 
    [-rom_path <string>]:
        location of ROM data map files (default: 'current working directory') 
    [-rom_data_map_file <string>]:
        file providing mapping of ROM instances to their data map files 
    [-dont_scan]:
        allows a PMBIST insertion flow without test signals when the PMBIST flops are not scan replaced 
    [-dont_scan_repair_registers]:
        allows repair registers to be non-scannable 
    [-rom_data_files <string>]:
        list of ROM data map files residing in locations specified by 'rom_path' option 
    [-direct_access_only]:
        insert without JTAG Macro 
    [-connect_to_jtag]:
        make connections from the PMBIST logic to the JTAG_Macro pins 
    [-dont_create_pmbist_ports]:
        do not create PMBIST control ports at the top-level design 
    [-preview]:
        generate configuration file only 
    [-technology <integer>]:
        technology node for which configuration file template is to be generated 
    [-technology_class <string>]:
        technology type (like finfet) for which configuration file template is to be generated 
    [-module_prefix <string>]:
        additional character string appended to the default prefix, 'tem', placed on all modules created and inserted by this command 
    [-dft_cfg_mode <dft_configuration_mode>]:
        configuration mode in which netlist back-tracing is to be done under JTAG or all modes of operations (default: pmbist) 
    [-alt_dft_cfg_mode <dft_configuration_mode>]:
        configuration mode in which netlist back-tracing is to be done for non-JTAG mode of operation (default: pmbist) 
    [-amu_location <design|module|hinst>]:
        location to place the algorithm memory unit (default: top level design) 
    [<design>]:
        name of the top-level design 

==================================================
COMMAND: add_pmbist_access_method
==================================================
  add_pmbist_access_method: inserts on-demand PMBIST interface for memories 

Usage: add_pmbist_access_method [-module_prefix <string>] [-alt_dft_cfg_mode <dft_configuration_mode>] [-dont_scan] -asu_vectors_file <string> [-directory <string>] [-fcu_instance <hinst>]
           [-amu_instance <hinst>] [<design>]

    [-module_prefix <string>]:
        additional character string appended to the default prefix, 'tem', placed on all modules created and inserted by this command 
    [-alt_dft_cfg_mode <dft_configuration_mode>]:
        configuration mode in which netlist back-tracing is to be done (default: pmbist_od) 
    [-dont_scan]:
        allows access method insertion flow without test signals when the access method flops are not scan replaced 
    -asu_vectors_file <string>:
        vector file for application specific unit generation 
    [-directory <string>]:
        work directory (default: './pmbist_od_<design name>') 
    [-fcu_instance <hinst>]:
        name of the associated fuse control unit instance 
    [-amu_instance <hinst>]:
        name of the associated algorithm memory unit instance 
    [<design>]:
        name of the top-level design 

==================================================
COMMAND: add_ptam
==================================================
  add_ptam: inserts Power Test Access Mechanism (PTAM) logic 

Usage: add_ptam -power_test_enable <pin|hpin|port> [-power_test_enable_active {high|low}] [-shift_enable <test_signal>] -instruction <jtag_instruction> [-preview] [-dont_map]
           [-dont_check_dft_rules] [-connect_to_jtag] [-directory <string>]

    -power_test_enable <pin|hpin|port>:
        name of the pin/port used to enable PTAM logic and override the design's power manager control pins 
    [-power_test_enable_active {high|low}]:
        active value of the power test enable pin/port {high|low} (default: high) 
    [-shift_enable <test_signal>]:
        shift-enable test signal used to override the PTAM gating logic of the power manager output control signals during scan test 
    -instruction <jtag_instruction>:
        name of the TAP instruction 
    [-preview]:
        reports results of command without modifying the netlist 
    [-dont_map]:
        prevents the inserted logic from being mapped even if the design is already mapped to the target library 
    [-dont_check_dft_rules]:
        do not run check_dft_rules after inserting PTAM logic 
    [-connect_to_jtag]:
        connects the PTAM logic to the tap (JTAG) controller instance. A tap instance must first be created with the insert_dft boundary_scan command. If -connect_to_jtag is not specified 
        and a tap instance is detected in the current session, a warning message will be issued to notify of the tap instance's existence, otherwise there will be no attempt to connect to a 
        tap instance 
    [-directory <string>]:
        output directory for sequence and assign files 

==================================================
COMMAND: add_scan_power_gating
==================================================
  add_scan_power_gating: inserts gating logic at selected flop outputs to minimize switching power during scan shift 

Usage: add_scan_power_gating -max_number_of_test_points <integer> [-min_slack <integer>] [-test_control <test_signal>] [-preview] [-dont_check_dft_rules] [-input_test_point_file <string>]
           [-output_test_point_file <string>] [-report_virtual_scan_power <float>+] [-power_mode <power_mode>] [<design>]

    -max_number_of_test_points <integer>:
        maximum number of nodes to gate 
    [-min_slack <integer>]:
        minimum slack (in ps) for inserting a test point <2000> 
    [-test_control <test_signal>]:
        test signal used to enable the testpoint 
    [-preview]:
        preview mode 
    [-dont_check_dft_rules]:
        do not run check_dft_rules after inserting scan power gating 
    [-input_test_point_file <string>]:
        input test-point file name 
    [-output_test_point_file <string>]:
        output test-point file name 
    [-report_virtual_scan_power <float>+]:
        "<scan-clock frequency (MHz)> [<flop-toggle percentage>]" reports scan power if the suggested testpoints were inserted; flop-toggle percentage defaults to 50% of clock frequency 
    [-power_mode <power_mode>]:
        report virtual scan power for the given mode 
    [<design>]:
        design to insert testpoints in 

==================================================
COMMAND: add_shadow_logic
==================================================
  add_shadow_logic: inserts test logic to enable testing of shadow logic around a module 

Usage: add_shadow_logic [-around <inst|hinst>+] [-auto] [-min_shadow_logic_pins <integer>] [-exclude_shadow_logic <inst|hinst>+] [-mode <string>] [-balance] [-preview] [-dont_map]
           [-test_control <test_signal>] [-test_clock_pin <pin|hpin|port>] [-rise] [-fall] [-group <string>]+ [-exclude <string>]+ [-only <string>]+

    [-around <inst|hinst>+]:
        instance around which DFT shadow logic must be inserted 
    [-auto]:
        automatic shadow logic insertion 
    [-min_shadow_logic_pins <integer>]:
        inserts shadow logic on blackboxes with pins exceeding this value (default: 10) 
    [-exclude_shadow_logic <inst|hinst>+]:
        exclude shadow logic around these instances 
    [-mode <string>]:
        mode of operation {no_share|share|bypass} 
    [-balance]:
        group unmatched inputs/outputs to have a balanced number of groups 
    [-preview]:
        show what would be done only, but do not modify the design 
    [-dont_map]:
        do not techmap the inserted logic even though design is mapped 
    [-test_control <test_signal>]:
        test signal used to control the DFT logic 
    [-test_clock_pin <pin|hpin|port>]:
        use this clock pin to trigger control/observation flops 
    [-rise]:
        use rising edge of test clock 
    [-fall]:
        use falling edge of test clock 
    [-group <string>]:
        what pins to observe together and/or control to the same value 
    [-exclude <string>]:
        do not control/observe these pins 
    [-only <string>]:
        only control/observe these pins 

==================================================
COMMAND: add_shift_register_test_points
==================================================
  add_shift_register_test_points: identifies additional shift registers by inserting test points 

Usage: add_shift_register_test_points [-preview] [-write_to_log_file <string>] [-shift_enable <test_signal>] [-incremental] [-max_number_of_test_points <integer>] [-design <design>]

    [-preview]:
        show what would be done only, but do not modify the design 
    [-write_to_log_file <string>]:
        does not insert testpoints but writes them to the file 
    [-shift_enable <test_signal>]:
        shift enable signal used to control test point 
    [-incremental]:
        identify shift registers in incremental mode 
    [-max_number_of_test_points <integer>]:
        number of test points (default: all) 
    [-design <design>]:
        top-block (required if there are multiple top designs) 

==================================================
COMMAND: add_test_compression
==================================================
  add_test_compression: inserts compression logic. For the Unified Compression flow, you can run 'help dft_compression_*' to see all available attributes of that flow. 

Usage: add_test_compression [-use_existing_channels <actual_scan_chain>+] [-use_existing_wrapper_channels <actual_scan_chain>+] [-build_new_scan_chains <integer>]
           [-asymmetric_scan_ins <integer>] [-decompressor <string>] [-compressor <string>] [-mask <string>] [-mask_sharing_ratio <integer>] [-bypass_register] [-use_wir_macro <inst|hinst>]
           [-dont_map] [-inside <inst|hinst>] [-top] [-auto_create] [-2d_compression] [<design>]

    [-use_existing_channels <actual_scan_chain>+]:
        name(s) of the actual scan chains that are to be used as compression channels 
    [-use_existing_wrapper_channels <actual_scan_chain>+]:
        name(s) of the actual scan chains that are to be used as wrapper compression channels 
    [-build_new_scan_chains <integer>]:
        the number of top level scan chains desired 
    [-asymmetric_scan_ins <integer>]:
        number of scan in pins for the asymmetric macro 
    [-decompressor <string>]:
        type of decompression logic to be built, 'broadcast' or 'xor' (default: broadcast) 
    [-compressor <string>]:
        type of compression logic to be built, 'xor' or 'hybrid' (default: xor) 
    [-mask <string>]:
        specifies to insert masking logic of type 'wide0', 'wide1', or 'wide2' (default is not to insert masking logic) 
    [-mask_sharing_ratio <integer>]:
        number of internal scan channels sharing a mask register 
    [-bypass_register]:
        insert a bypass macro to register the scan paths in 1500 bypass mode for hierarchical test flows 
    [-use_wir_macro <inst|hinst>]:
        use the specified wrapper instruction register for hierarchical test flows 
    [-dont_map]:
        inserted macros are left unmapped 
    [-inside <inst|hinst>]:
        instance in which to instantiate the compression logic 
    [-top]:
        insert hierarchical compression logic at the top level 
    [-auto_create]:
        automatically creates the necessary compression control signals as top-level ports 
    [-2d_compression]:
        2D Compression 
    [<design>]:
        insert compression on this top design 

