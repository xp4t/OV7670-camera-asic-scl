Usage: update_library_set -name <library_set> [-timing <string>+] [-target_timing <string>+] [-link_timing <string>+] [-aocv <string>+] [-socv <string>+] [-si <string>+]

    -name <library_set>:
        name of the library_set 
    [-timing <string>+]:
        lib_filenames 
    [-target_timing <string>+]:
        lib_filenames 
    [-link_timing <string>+]:
        lib_filenames 
    [-aocv <string>+]:
        aocv files 
    [-socv <string>+]:
        socv files 
    [-si <string>+]:
        si library file names 

==================================================
COMMAND: update_metric_definition
==================================================
  update_metric_definition: get a metric definition 

Usage: update_metric_definition -name <string> [-tcl <string>] [-type <string>] [-description <string>] [-units <string>] [-precision <integer>] [-compare <string>] [-threshold <string>]
           [-no_inheritance] [-inherit_no_children] [-inheritance_tcl <string>] [-target <string>] [-warning <string>] [-tools <string>] [-id <string>]

    -name <string>:
        metric name 
    [-tcl <string>]:
        tcl code to generate the metric value 
    [-type <string>]:
        metric type 
    [-description <string>]:
        metric description 
    [-units <string>]:
        metric units 
    [-precision <integer>]:
        metric display precision (default 0) 
    [-compare <string>]:
        compare function 
    [-threshold <string>]:
        threshold for any comparison 
    [-no_inheritance]:
        disable inheritance of the metric 
    [-inherit_no_children]:
        run inheritance tcl even when there are no child values 
    [-inheritance_tcl <string>]:
        tcl for combining children values. Not executed in the global namespace. Equivalent proc args are {children previous children_uuid self_uuid previous_uuid metric db_id} 
    [-target <string>]:
        target or name of metric containing the target value 
    [-warning <string>]:
        warning threshold or name of metric containing the threshold value 
    [-tools <string>]:
        list of tools which the tcl code will run in 
    [-id <string>]:
        database ID 

==================================================
COMMAND: update_names
==================================================
  update_names: change names of select objects 

Usage: update_names [-quiet] [-unresolved_ok] [-skip_bus_net] [-local] [-hnet] [-inst] [-design] [-module] [-port_bus] [-hport_bus] [-force] [-vhdl] [-verilog] [-system_verilog] [-nocase]
           [-prefix <string>] [-log <string>] [-append_log] [-lec] [-first_restricted <string>] [-suffix <string>] [-last_restricted <string>] [-restricted <string>] [-replace_str <string>]
           [-reserved_words <string>] [-map <string>] [-allowed <string>] [-max_length <integer>] [-lower_to_upper] [-upper_to_lower] [-collapse_name_space] [-name_collision]
           [-dummy_net_prefix <string>] [-regexp] [-check_internal_net_name] [<inst|hinst|design>]

    [-quiet]:
        disable messages (CHNM-102, CHNM-103 and CHNM-110) 
    [-unresolved_ok]:
        change names of unresolved modules 
    [-skip_bus_net]:
        change names of scalar net only 
    [-local]:
        disable recursive mode (default is recursive) 
    [-hnet]:
        change names of net objects 
    [-inst]:
        change names of instance objects 
    [-design]:
        change names of design objects 
    [-module]:
        change names of subdesign objects 
    [-port_bus]:
        change names of port_bus objects 
    [-hport_bus]:
        change names of hport_bus objects 
    [-force]:
        execute change even if object is preserved 
    [-vhdl]:
        replace VHDL reserved words 
    [-verilog]:
        replace Verilog reserved words 
    [-system_verilog]:
        replace System Verilog reserved words 
    [-nocase]:
        enable case_insensitive name-spaces 
    [-prefix <string>]:
        add a prefix 
    [-log <string>]:
        generates log 
    [-append_log]:
        appends the log. Could be used only with -log 
    [-lec]:
        captures log changes in LEC preferred format 
    [-first_restricted <string>]:
        restricted first characters (e.g. " 0 1 2") 
    [-suffix <string>]:
        add a suffix 
    [-last_restricted <string>]:
        restricted last characters (e.g. "0 1 2") 
    [-restricted <string>]:
        list of restricted strings (to be replaced with 'replace_str') 
    [-replace_str <string>]:
        replacement-string (default is '_'). Use NULL for the replacement string to be null 
    [-reserved_words <string>]:
        words to be avoided (e.g. "begin end") 
    [-map <string>]:
        {{"from" "to"} ...} character mapping 
    [-allowed <string>]:
        characters allowed in names (min 10) (e.g. "a b c d e f g h i 1 2 3") 
    [-max_length <integer>]:
        limit name lengths 
    [-lower_to_upper]:
        change names of all objects from lower case to upper case (instance|port|hnet|subport|design|subdesign) 
    [-upper_to_lower]:
        change names of all objects from upper case to lower case (instance|port|hnet|subport|design|subdesign) 
    [-collapse_name_space]:
        no port, net or instance in the design should have the same name 
    [-name_collision]:
        specified prefix/suffix values are used only for resolving name collision during update_names 
    [-dummy_net_prefix <string>]:
        prefix for the naming of dummy nets tied to unconnected pins 
    [-regexp]:
        allows to specify character ranges with -allowed or -first_restricted option 
    [-check_internal_net_name]:
        rename any net whose name matches that of a port|subport but is actually not connected to the corresponding port|subport 
    [<inst|hinst|design>]:
        change names under the specified instance hierarchy or top design 

