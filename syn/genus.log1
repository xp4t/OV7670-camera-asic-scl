           [-active {high|low}] [-create_port] [-default_shift_enable] [-multi_mode] [-scan_shift] [-ideal] [-cfg_pad <test_signal>] [-shared_input] [-test_only] [-index <integer>]
           [-wir_signal] [-wir_reset_value {high|low}] [-wir_tm_value {high|low}] [-pipeline_depth <integer>] [-shared_output] [-lec_value {0|1|no_value|auto}] [-hookup_pin <pin|hpin>]
           [-hookup_polarity {inverted|non_inverted}] [<hport|port|pin|hpin>] [-port_bus <port|port_bus|hport_bus>] [-design <design>]

    [-name <string>]:
        test signal name 
    -function {parallel_sdi|parallel_sdo|compress_sdi|compress_sdo|serial_sdi|serial_sdo|select_wir|select_serial|select_bypass|shift_enable|test_mode|scan_clock|lssd_scan_clock_a|lssd_scan_clock_b|aux_scan_clock|async_set_reset|test_clock|compression_clock|compression_enable|spread_enable|pipe_sen|mask_load|mask_enable|misr_reset_enable|in_pipe_bypass|out_pipe_bypass|decomp_pipe_bypass|comp_pipe_bypass|codec_pipe_bypass|cpi_over_npi|first_core|wint|wext|wrapper_reset|wrapper_clock|wrapper_and_compression_clock|shift_wr|capture_wr|update_wr|wir_test|custom|broadcast_enable|serial_wrck|elastic_reset|smartscan_enable|smartscan_broadcast|opcg_enable|opcg_trigger|opcg_load|opcg_load_clock|opcg_pllclk_capture|opcg_los_enable|lbist_test_enable|lbist_direct_reset|lbist_direct_done|lbist_direct_fail|lbist_direct_pass|lbist_direct_enable|lbist_setbist|lbist_runbist|lbist_run|misr_bypass|mbist_retention_test_out|lp_staggered_shift_mode|misr_reset|pipe_reset|lp_gating_enable|lp_gating_load|swizzle_enable|async_hold|segment_bypass}:
        function of the test signal 
    [-active {high|low}]:
        active value (high|low) 
    [-create_port]:
        create port if it does not exist 
    [-default_shift_enable]:
        make this the default shift enable signal 
    [-multi_mode]:
        test signal only for multi mode connection 
    [-scan_shift]:
        consider signal as clock while writing ATPG file 
    [-ideal]:
        sets ideal network true 
    [-cfg_pad <test_signal>]:
        configure connected pad using the test-signal 
    [-shared_input]:
        whether the test signal is shared with a functional pin 
    [-test_only]:
        whether the test signal is used for test purpose only 
    [-index <integer>]:
        index of the test signal 
    [-wir_signal]:
        specifies that the test signal will be driven off a WIR 
    [-wir_reset_value {high|low}]:
