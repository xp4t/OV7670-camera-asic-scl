    [-nwell_analysis]:
        check the design for shared and insulated nwell violations 
    [-license <string>]:
        CLP license to be used 
    [-pre_read <string>]:
        an extra dofile to be source'd from dofile right before reading library/design 
    [-pre_exit <string>]:
        an extra dofile to be source'd from dofile right before 'exit' 
    [-tcl_mode]:
        run CLP in TCL mode 
    [-lp_only]:
        whether to report LP related error/warning. This is the default 
    [-design <string>]:
        specify design module in case of multiple top modules 

