==================================================
COMMAND: remove_assigns_without_opt
==================================================
  remove_assigns_without_optimization: replaces assign statements with buffers 

Usage: remove_assigns_without_opt [-buffer_or_inverter <libcell>] [-clock_buffer_or_inverter <libcell>] [-ignore_preserve_map_size_ok] [-allow_unloaded_buffers]
           [-ignore_preserve_setting] [-skip_ideal_nets] [-dont_respect_boundary_optimization] [-no_buffers_use_inverters] [-preserve_dangling_nets] [-dont_skip_unconstrained_paths]
           [-skip_hierarchical_subdesigns] [-include_local_constant_assigns] [-use_inverted_signal] [-ports <port>+] [-verbose] [-design <subdesign|design>]

    [-buffer_or_inverter <libcell>]:
        buffer or inverter for insertion 
    [-clock_buffer_or_inverter <libcell>]:
        clock library buffer or inverter for insertion on clock path 
    [-ignore_preserve_map_size_ok]:
        preserve_map_size_ok is to be ignored 
    [-allow_unloaded_buffers]:
        allow unloaded buffers to be created while removing assigns 
    [-ignore_preserve_setting]:
        ignores all preserve setting 
    [-skip_ideal_nets]:
        if this option is used then remove_assigns will not insert buffers in case of ideal nets 
    [-dont_respect_boundary_optimization]:
        if this option is used then remove_assign will disconnect the unloaded subports of subdesign with boundary optimization settings off 
    [-no_buffers_use_inverters]:
        look for inverters to be used in case the library does not have any buffers 
    [-preserve_dangling_nets]:
        preserve the net driven by the buffer/inverter inserted by remove_assigns if the net does not have a fanout in the next level of hierarchy and was not driven by a constant before 
        adding the buffer/inverter 
    [-dont_skip_unconstrained_paths]:
        remove assigns on unconstrained paths 
    [-skip_hierarchical_subdesigns]:
        do not remove assigns from any hierarchies inside provided design/subdesign 
    [-include_local_constant_assigns]:
        remove local constant driven assigns also which do not drive hierarchical ports 
    [-use_inverted_signal]:
        use inverter with inverted constant signal 
    [-ports <port>+]:
        remove assigns only on these ports 
    [-verbose]:
        displays all the messages 
    [-design <subdesign|design>]:
        top level designs or subdesigns to recur from 

