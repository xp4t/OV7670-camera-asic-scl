==================================================
COMMAND: all_fanout
==================================================

Usage: all_fanout [-from <pin|hpin|port|hnet>+] [-flat] [-only_cells] [-endpoints_only] [-clock_tree] [-levels <integer>] [-pin_levels <integer>] [-trace_through <string>]
           [-view <analysis_view>]

    [-from <pin|hpin|port|hnet>+]:
        sink list of pins,ports or nets to find the fanout from 
    [-flat]:
        returns all leaf level objects in the fanout cone of the sink list. The only non-leaf objects in the final result are the hierarchical objects (if any) in the sink list. If this 
        option is not given, only objects in the same hierarchical level as the sink list will be part of the final result 
    [-only_cells]:
        returns only the instance names of all objects in the fanout cone of the sink list 
    [-endpoints_only]:
        returns only the endpoints in the fanout cone of the sink list 
    [-clock_tree]:
        fanout for the clock network 
    [-levels <integer>]:
        returns all objects in the fanout cone of the sink list that are present within this many logic levels of the sink object 
    [-pin_levels <integer>]:
        returns all objects in the fanout cone of the sink list that are present within this many pin levels of the sink object 
    [-trace_through <string>]:
        trace fanout arcs through given options 
    [-view <analysis_view>]:
        analysis view to read constraints 

==================================================
COMMAND: all_inputs
==================================================

Usage: all_inputs [-clock <clock>+] [-clock_domains <clock_domain>+] [-edge_triggered] [-level_sensitive] [-no_clocks]

    [-clock <clock>+]:
        returns all input ports with input delay relative to this clock(s) 
    [-clock_domains <clock_domain>+]:
        returns all input ports with input delay relative to clocks in this clock domain 
    [-edge_triggered]:
        returns all input ports with non level sensitive input delay 
    [-level_sensitive]:
        returns all input ports with level sensitive input delay 
    [-no_clocks]:
        returns all input ports which do not have a clock definition on them 

==================================================
COMMAND: all_outputs
==================================================

Usage: all_outputs [-clock <clock>+] [-clock_domains <clock_domain>+] [-edge_triggered] [-level_sensitive]

    [-clock <clock>+]:
        returns all output ports with output delay relative to this clock(s) 
    [-clock_domains <clock_domain>+]:
        returns all output ports with output delay relative to clocks in this clock domain 
    [-edge_triggered]:
        returns all output ports with non level sensitive output delay 
    [-level_sensitive]:
        returns all output ports with level sensitive output delay 

==================================================
COMMAND: all_registers
==================================================

Usage: all_registers [-no_hierarchy] [-clock <clock>+] [-rise_clock <clock>+] [-fall_clock <clock>+] [-cells] [-data_pins] [-clock_pins] [-slave_clock_pins] [-async_pins] [-output_pins]
           [-flops] [-latches] [-level_sensitive] [-edge_triggered] [-macros] [-master_slave] [-exclude <inst|hinst>+] [-clock_domains <clock_domain>+] [-inverted_output]

    [-no_hierarchy]:
        returns sequential elements in the top-level 
    [-clock <clock>+]:
        clocks to return seqs for 
    [-rise_clock <clock>+]:
        seqs triggered by rising clock edge 
    [-fall_clock <clock>+]:
        seqs triggered by falling clock edge 
    [-cells]:
        return the lib_cell instance of the sequential elements 
    [-data_pins]:
        return data pins 
    [-clock_pins]:
        returns clock pins 
    [-slave_clock_pins]:
        returns slave clock pins 
    [-async_pins]:
        returns the async pins 
    [-output_pins]:
        returns output pins 
    [-flops]:
        returns a collection of edge-triggered sequential instances 
    [-latches]:
        returns a collection of level sensitive sequential instances 
    [-level_sensitive]:
        returns only latches 
    [-edge_triggered]:
        returns only flops 
    [-macros]:
        returns only macros 
    [-master_slave]:
        returns master-slave flops 
    [-exclude <inst|hinst>+]:
        list of seqs to be excluded 
    [-clock_domains <clock_domain>+]:
        clock domains to return seqs for 
    [-inverted_output]:
        returns seqs with inverted output (Qbar) 

