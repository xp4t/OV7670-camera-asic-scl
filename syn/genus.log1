==================================================
COMMAND: write_do_lec
==================================================
  write_do_lec: writes out an LEC command file 

Usage: write_do_lec [-top <string>] [-golden_design <string>] [-revised_design <string>] [-sim_lib <string>] [-sim_plus_liberty] [-log_file <string>] [-cpf_golden <string>]
           [-cpf_revised <string>] [-1801_golden <string>] [-1801_revised <string>] [-no_insert_iso_in_dof] [-env_var <string>] [-hier] [-no_dft] [-flat] [-no_lp] [-pre_read <string>]
           [-pre_compare <string>] [-pre_exit <string>] [-dft_constraint_file <string>] [-no_exit] [-smart] [-low_power_analysis] [-gzip_fv_json] [-fastrtl2elab] [-fastelab2gen]
           [-fastgen2fvmap] [-write_session <string>] [-checkpoint <string>] [-cw_sim <string>] [-verbose] [-tmp_dir <string>] [-hierarchical_reference] [-rtl_revised] [> file]

    [-top <string>]:
        name of the top-level design in Genus 
    [-golden_design <string>]:
        path to golden design 
    [-revised_design <string>]:
        path to revised design 
    [-sim_lib <string>]:
        simulation library (in Verilog-1995) 
    [-sim_plus_liberty]:
        whether the simulation library is an addition to, or a replacement of, the synthesis library 
    [-log_file <string>]:
        name of the LEC log_file 
    [-cpf_golden <string>]:
        name of the golden CPF file 
    [-cpf_revised <string>]:
        name of the revised CPF file 
    [-1801_golden <string>]:
        name of the golden 1801 file 
    [-1801_revised <string>]:
        name of the revised 1801 file 
    [-no_insert_iso_in_dof]:
        donot insert isolation in lec dofile in golden and revised design 
    [-env_var <string>]:
        names and values of UNIX environment variables to be used in library, design and log filenames in dofile 
    [-hier]:
        whether to do hierarchical LEC comparison 
    [-no_dft]:
        whether to write DFT constraints in dofile 
    [-flat]:
        whether to do flattened LEC comparison 
    [-no_lp]:
        whether to check power intent equivalency 
    [-pre_read <string>]:
        an extra dofile to be source'd from dofile right before reading library/design 
    [-pre_compare <string>]:
        an extra dofile to be source'd from dofile right before 'set system mode lec' or 'write hier_compare dofile' 
    [-pre_exit <string>]:
        an extra dofile to be source'd from dofile right before 'exit' 
    [-dft_constraint_file <string>]:
        dft constraints file, to be source'd from dofile before 'compare' 
    [-no_exit]:
        whether to skip the exit command at end of dofile 
    [-smart]:
        add adaptive-proof commands and information on massively parallel hierarchical compare to the dofile (Conformal Smart LEC license required) 
    [-low_power_analysis]:
        add the Conformal Low Power commands to compare the power domains between the golden and revised designs. Power intent must be present 
    [-gzip_fv_json]:
        compress the implementation information file (Conformal 19.10-s300 or newer required) 
    [-fastrtl2elab]:
        specify an abbreviated dofile for quick diagnosis, RTL vs elaborated 
    [-fastelab2gen]:
        specify an abbreviated dofile for quick diagnosis, elaborated vs generic 
    [-fastgen2fvmap]:
        specify an abbreviated dofile for quick diagnosis, generic vs fv_map 
    [-write_session <string>]:
        name of LEC session to write at the end 
    [-checkpoint <string>]:
        name of LEC checkpoint file to save at the end 
    [-cw_sim <string>]:
        specify simulation language model of ChipWare component, valid option is 'V1995|V2001|SV|VHDL1987|VHDL1993' 
    [-verbose]:
        whether the generated dofile reports verbosely 
    [-tmp_dir <string>]:
        name of the output LEC directory 
    [-hierarchical_reference]:
        enable hierarchical reference connection in write_do_lec 
    [-rtl_revised]:
        revised design is DFT inserted back-annotated RTL 

