        filter attribute based on categories 
    [-command]:
        perform command search only 
    [-detail]:
        provide full informaiton in multi-match 
    [-message]:
        perform message search only 
    [-obj]:
        perform object search only 
    [-summary]:
        provide short description in single match 
    [<string>]:
        specify a command name, message ID, object type or attribute 
