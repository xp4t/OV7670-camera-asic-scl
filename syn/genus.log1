    -basename <string>:
        path for ILM data {Genus: dirname/filename, Innovus: dirname} 
    [-lef_file <string>]:
        path for Innovus LEF file 
    [-upf_file <string>]:
        path for UPF file 
    [-view_map <string>]:
        SDC views for mapping. Specify a list of lists: {{view1 top_view1} {view2 top_view2} ...} 
    [-corner_map <string>]:
        SPEF corners for mapping. Specify a list of lists: {{corner1 top_corner1} {corner2 top_corner2} ...} 
    -module_name <string>:
        name of the ILM module 
    [-logical]:
