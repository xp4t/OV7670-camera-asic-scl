        skip scan mapping of LBIST flops 
    [-dont_use_opcg]:
        do not use the inserted OPCG for LBIST 
    [-tester_controlled_pins <port>+]:
        tester available ports that do not need LBIST testpoints 
    [-free_running_clocks <test_clock>+]:
        free running clocks 
    [-control_inputs_to_0 <port>+]:
        add testpoints to control input to logic zero value when LBIST is running 
    [-control_inputs_to_1 <port>+]:
        add testpoints to control input to logic one value when LBIST is running 
    [-direct_access]:
        direct access support 
    [-programmable_direct_access]:
        programmable direct access support 
    [-direct_reset <port>]:
        top level port for direct access reset 
    [-direct_reset_negedge]:
        direct access reset is negedge 
    [-direct_enable <port>]:
        top level port for direct access LBIST enable 
    [-direct_done_output <port>]:
        top level port to monitor LBIST completion 
    [-direct_pass_output <port>]:
        top level port to monitor LBIST pass 
    [-direct_fail_output <port>]:
        top level port to monitor LBIST fail 
    [-add_masking]:
        add LBIST channel masking logic 
    [-scan_patterns <integer>]:
        default number of patterns for scan test 
    [-scan_pattern_counter_length <integer>]:
        scan test pattern counter length 
    [-scan_pattern_counter_parallel_load_pins <port|pin|hpin>+]:
        scan test pattern counter parallel load pins 
    [-set_patterns <integer>]:
        default number of patterns for set test 
    [-set_pattern_counter_length <integer>]:
        set test pattern counter length 
    [-set_pattern_counter_parallel_load_pins <port|pin|hpin>+]:
        set test pattern counter parallel load pins 
    [-async_set_signals <test_signal>+]:
        asynchronous set signals that are controlled during set testing 
    [-reset_patterns <integer>]:
        default number of patterns for reset test 
    [-reset_pattern_counter_length <integer>]:
        reset test pattern counter length 
    [-reset_pattern_counter_parallel_load_pins <port|pin|hpin>+]:
        reset test pattern counter parallel load pins 
    [-async_reset_signals <test_signal>+]:
        asynchronous reset signals that are controlled during reset testing 
    [-static_patterns <integer>]:
        default number of patterns for static test 
    [-static_pattern_counter_length <integer>]:
        static test pattern counter length 
    [-static_pattern_counter_parallel_load_pins <port|pin|hpin>+]:
        static test pattern counter parallel load pins 
    [-dynamic_patterns <integer>]:
        default number of patterns for dynamic test 
    [-dynamic_pattern_counter_length <integer>]:
        dynamic test pattern counter length 
    [-dynamic_pattern_counter_parallel_load_pins <port|pin|hpin>+]:
        dynamic test pattern counter parallel load pins 
    [-scan_channel_counter_length <integer>]:
        scan channel counter length 
    [-scan_channel_counter_parallel_load_pins <port|pin|hpin>+]:
        scan channel counter parallel load pins 
    [-scan_window <integer>]:
        default size of scan window 
    [-scan_window_counter_length <integer>]:
        scan window counter length 
    [-scan_window_counter_parallel_load_pins <port|pin|hpin>+]:
        scan window counter parallel load pins 
    [-scan_window_pulse_value <integer>]:
        scan window value at which (first) scan pulse occurs 
    [-scan_enable_delay <integer>]:
        default delay after scan enable toggle 
    [-scan_enable_delay_counter_length <integer>]:
        scan enable delay counter length 
    [-scan_enable_delay_counter_parallel_load_pins <port|pin|hpin>+]:
        scan enable delay counter parallel load pins 
    [-capture_window <integer>]:
        default size of capture window 
    [-capture_window_counter_length <integer>]:
        capture window counter length 
    [-capture_window_counter_parallel_load_pins <port|pin|hpin>+]:
        capture window counter parallel load pins 
    [-capture_window_capture_value <integer>]:
        test window value at which (first) capture pulse occurs 
    [-capture_window_launch_value <integer>]:
        test window value at which launch pulse(s) occur(s) 
    [-set_reset_test_window <integer>]:
        test window size for set/reset test 
    [-set_reset_pulse_width <integer>]:
        asynchronous pulse width for set/reset test 
    [-lbist_clock_ref_period <integer>]:
        bist clock reference period in ps 
    [-lbist_clock_osc_period <integer>]:
        bist clock oscillator period in ps 
    [-parallel_load_control_bits]:
        support for direct access parallel load of the control bits 
    [-control_bits_parallel_load_pins <port|pin|hpin>+]:
        parallel load pins for control bits 
    [-parallel_load_prpg]:
        support for direct access parallel load of the PRPG 
    [-prpg_parallel_load_pins <port|pin|hpin>+]:
        parallel load pins for PRPG 
    [-parallel_load_misr]:
        support for direct access parallel load of the MISR 
    [-misr_parallel_load_pins <port|pin|hpin>+]:
        parallel load pins for MISR 
    [-misr_parallel_unload_pins <port|pin|hpin>+]:
        parallel unload pins for MISR 
    [-parallel_load_mask]:
        support for direct access parallel load of the masking data 
    [-mask_parallel_load_pins <port|pin|hpin>+]:
        parallel load pins for masking data 
    [-programmable_direct_access_parallel_load_enable <port>]:
        programmable direct access parallel load enable port 
    [-auto_create_programmable_direct_access_parallel_ports]:
        auto-create ports for unspecified programmable direct access parallel busses (default: tie to default constants) 
    [-preview]:
        preview LBIST insertion 
    [<design>]:
        insert logic bist for this top module 

